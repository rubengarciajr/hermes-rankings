{
  "name": "hermes-rank",
  "version": "1.0.1",
  "description": "Submit your Hermes Agent achievements to the public leaderboard at hermes-rankings.com",
  "keywords": [
    "hermes",
    "hermes-agent",
    "agent",
    "leaderboard",
    "achievements",
    "nous-research",
    "cli"
  ],
  "homepage": "https://www.hermes-rankings.com",
  "bugs": {
    "url": "https://www.hermes-rankings.com/docs/install"
  },
  "license": "MIT",
  "author": "Hermes Rankings",
  "type": "module",
  "bin": {
    "hermes-rank": "./dist/index.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hermesranker/schema": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
