# Neon Postgres (pooled connection for runtime)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Direct (non-pooled) connection for Drizzle migrations
DIRECT_URL=postgres://user:pass@host/db?sslmode=require

# Auth.js (GitHub OAuth, used only for the optional "Verified" badge link)
AUTH_SECRET=                     # openssl rand -base64 32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Cloudflare Turnstile (gates first-run CLI registration)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel KV / Upstash Redis (rate limiting)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public URL (used by the CLI to open the verify page)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron auth (Vercel Cron sends this header — set to a random secret)
CRON_SECRET=
